#!/bin/sh
# combo 主分支保护 hook(pre-commit):
# 禁止在 main 分支上做任何本地提交(含 *.md 文档),强制走 worktree + feat 分支 + PR
# 流程(见 AGENTS.md「Git 开发流程」)。远端 GitHub 分支保护同样对管理员强制生效,
# main 上的直接推送会被一律拒绝。
#
# 放行条件:
#   - 当前分支不是 main;
#   - 合并提交(存在 MERGE_HEAD,避免本地 git merge 卡在半途;正常合并请用 gh pr merge)。
#
# 安装位置:全局 core.hooksPath 目录(combo 署名功能接管为
# ~/.config/combo/git-hooks/,repo 内 .git/hooks 在 hooksPath 存在时会被忽略)。
# 本脚本自带仓库范围守卫:仅在 combo 主仓及其 worktree(目录名 combo / combo-*)
# 中生效,不影响其他仓库。

# 守卫:只对 combo 仓库生效(主仓目录名 combo,worktree 为 combo-*)。
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
case "$(basename "$top")" in
  combo|combo-*) ;;
  *) exit 0 ;;
esac

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
[ "$branch" = "main" ] || exit 0

gitdir=$(git rev-parse --git-dir)
[ -f "$gitdir/MERGE_HEAD" ] && exit 0

echo ""
echo "⛔ 禁止在 main 分支上直接提交(push 到 main 必须走 PR,GitHub 对管理员也强制生效)。"
echo "   请改用 worktree + feat 分支 + PR 流程:"
echo "     git worktree add ../combo-feat-xxx -b feat/xxx"
echo "     # ...开发、提交..."
echo "     git push -u origin feat/xxx"
echo "     gh pr create && gh pr merge --merge"
exit 1
