# 正式签名配置模板:复制为 android/keystore.properties 并填写真实值(该文件被 gitignore,不入库)。
# 存在 keystore.properties 时 release 使用正式签名;否则回退 debug 签名(仅本地测试可安装,勿用于发布)。
#
# 生成密钥(一次性):
#   keytool -genkeypair -v -keystore combo.keystore -alias combo -keyalg RSA -keysize 2048 -validity 3650
#
storeFile=/absolute/path/to/combo.keystore
storePassword=你的密钥库密码
keyAlias=combo
keyPassword=你的别名密码
